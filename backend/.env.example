# Groq API key — https://console.groq.com/keys
# Nota: la variable se llama ANTHROPIC_API_KEY por razones historicas,
# pero el cliente que se instancia es Groq (ver services/claude_service.py)
ANTHROPIC_API_KEY=gsk_your_key_here

# Modelos de Groq. Groq retira modelos cada tanto y cuando eso pasa la API
# devuelve 404 model_not_found; estas variables permiten cambiarlos sin
# tocar codigo. Ver el catalogo vigente en https://console.groq.com/docs/models
# GROQ_VISION_MODEL debe ser multimodal (aceptar image_url).
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

MAX_FILE_SIZE_MB=10
TMP_DIR=/tmp/docuscan
DEBUG=true
PORT=8000
